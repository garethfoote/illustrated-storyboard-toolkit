{
  "name": "illustrated-storyboard-toolkit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "build": "npm run build:carbon && npm run build:assets",
    "build:carbon": "node scripts/build-carbon.mjs",
    "build:assets": "node scripts/build-asset-manifest.mjs",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@carbon/styles": "1.110.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^8.2.0"
  }
}
